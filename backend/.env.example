# Prism Desk backend configuration. Copy to backend/.env and fill in.
# Keep comments on their own lines: systemd (EnvironmentFile) does not strip
# "# ..." after a value, so it would become part of the value.
# Never commit or copy the real .env file between machines; create a new one.
# Lab workstation: campus IP 10.150.51.90 (IITG Connect), hostname "prismdesk".
# Origins must match exactly what users type in the browser bar. Campus
# users reach the server by IP unless IITG adds a DNS name for "prismdesk".

APP_NAME=Prism Desk
# development | production (production forces Secure cookies)
APP_ENV=production

# PostgreSQL (listen on localhost only; only the backend connects)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=prism_desk
DATABASE_USER=prism_user
# A new, long random password, e.g. from: openssl rand -base64 24
DATABASE_PASSWORD=change-me

# Never enable on a shared machine: echo prints SQL parameters.
SQL_ECHO=false
LOG_LEVEL=INFO
API_DOCS_ENABLED=true

# Sessions
SESSION_EXPIRE_HOURS=8
SESSION_INACTIVITY_MINUTES=30
SESSION_COOKIE_NAME=prism_session
CSRF_HEADER_NAME=X-CSRF-Token
# Secure cookies need HTTPS. APP_ENV=production always forces them on, so a
# plain-HTTP deployment cannot log in: use HTTPS (recommended), or for an
# HTTP-only trial set APP_ENV=development and COOKIE_SECURE=false.
COOKIE_SECURE=true

# Browser origins allowed to call the API (comma-separated). With the
# Nginx setup the frontend and API share one origin, e.g.:
CORS_ORIGINS=https://10.150.51.90,https://prismdesk
FRONTEND_BASE_URL=https://10.150.51.90

# Brute-force protection for login/registration (per client IP)
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
RATE_LIMIT_WINDOW_SECONDS=300
PAPER_LOOKUP_RATE_LIMIT=60

PROJECT_DELETE_RETENTION_DAYS=90

# Discord (optional; leave empty to run without notifications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://10.150.51.90/api/v1/notifications/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_ANNOUNCEMENT_CHANNEL_ID=
# New papers are posted here and get a discussion thread each
DISCORD_RESEARCH_CHANNEL_ID=
# Server ID, used for "Discuss on Discord" links
DISCORD_GUILD_ID=
# One private Discord channel per project (bot needs Manage Channels + Manage Roles)
DISCORD_PROJECT_CHANNELS=true
DISCORD_PROJECT_CATEGORY_ID=
DISCORD_API_BASE_URL=https://discord.com/api/v10

# Paper metadata and journal catalog sources (outbound HTTPS from the server)
DOI_LOOKUP_URL=https://doi.org
CROSSREF_API_URL=https://api.crossref.org
ARXIV_API_URL=https://export.arxiv.org/api/query
OPENALEX_API_URL=https://api.openalex.org
# Optional free key from openalex.org/settings/api (bigger daily budget)
OPENALEX_API_KEY=

# Notification worker
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_RETRY_MAX_SECONDS=3600
NOTIFICATION_POLL_SECONDS=15
TASK_REMINDER_HOURS=24
CONFERENCE_REMINDER_DAYS=7

# Outbound proxy (campus networks). The API and the notification worker use
# these for Discord, DOI/Crossref/arXiv/OpenAlex and catalog downloads.
# systemd passes them to both services through EnvironmentFile. Keep
# NO_PROXY for local addresses. Leave commented out if no proxy is needed.
# HTTPS_PROXY=http://proxy.example:3128
# HTTP_PROXY=http://proxy.example:3128
# NO_PROXY=localhost,127.0.0.1,::1
